{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Dreamdocs task continuity snapshot v1",
  "description": "Shape only; semantic time, identity, deadline and continuity checks are performed by scripts/task_continuity.py. Unknown extra fields preserved for adapters.",
  "type": "object",
  "required": [
    "version",
    "reconciled_at",
    "next_check_at",
    "runtime",
    "tasks"
  ],
  "properties": {
    "version": {
      "const": 1,
      "type": "integer"
    },
    "reconciled_at": {
      "type": "string",
      "format": "date-time"
    },
    "next_check_at": {
      "type": "string",
      "format": "date-time"
    },
    "runtime": {
      "type": "object",
      "required": [
        "scheduler",
        "host",
        "observed_at",
        "next_check_at",
        "evidence"
      ],
      "properties": {
        "scheduler": {
          "enum": [
            "healthy",
            "unhealthy",
            "unknown",
            "not_configured"
          ]
        },
        "host": {
          "enum": [
            "online",
            "offline",
            "unknown"
          ]
        },
        "observed_at": {
          "anyOf": [
            {
              "type": "string",
              "format": "date-time"
            },
            {
              "type": "null"
            }
          ]
        },
        "next_check_at": {
          "anyOf": [
            {
              "type": "string",
              "format": "date-time"
            },
            {
              "type": "null"
            }
          ]
        },
        "evidence": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "tasks": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "manager",
          "executor",
          "status",
          "start_approved",
          "next_action",
          "acceptance",
          "evidence",
          "updated_at",
          "next_check_at",
          "handoffs",
          "blocker",
          "candidate",
          "review",
          "accepted"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "manager": {
            "type": "string",
            "minLength": 1
          },
          "executor": {
            "anyOf": [
              {
                "type": "string",
                "minLength": 1
              },
              {
                "type": "null"
              }
            ]
          },
          "status": {
            "enum": [
              "backlog",
              "ready",
              "in-progress",
              "review",
              "blocked",
              "paused",
              "future",
              "done"
            ]
          },
          "start_approved": {
            "type": "boolean"
          },
          "next_action": {
            "type": "string",
            "minLength": 1
          },
          "acceptance": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 1
          },
          "evidence": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 1
          },
          "updated_at": {
            "type": "string",
            "format": "date-time"
          },
          "next_check_at": {
            "anyOf": [
              {
                "type": "string",
                "format": "date-time"
              },
              {
                "type": "null"
              }
            ]
          },
          "handoffs": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "id",
                "worker",
                "stage",
                "requested_at",
                "acknowledged_at",
                "started_at",
                "finished_at",
                "evidence"
              ],
              "properties": {
                "id": {
                  "type": "string",
                  "minLength": 1
                },
                "worker": {
                  "type": "string",
                  "minLength": 1
                },
                "stage": {
                  "enum": [
                    "implementation",
                    "review",
                    "qa",
                    "integration"
                  ]
                },
                "requested_at": {
                  "type": "string",
                  "format": "date-time"
                },
                "acknowledged_at": {
                  "anyOf": [
                    {
                      "type": "string",
                      "format": "date-time"
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "started_at": {
                  "anyOf": [
                    {
                      "type": "string",
                      "format": "date-time"
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "finished_at": {
                  "anyOf": [
                    {
                      "type": "string",
                      "format": "date-time"
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "evidence": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "minLength": 1
                  },
                  "minItems": 1
                }
              }
            }
          },
          "blocker": {
            "anyOf": [
              {
                "type": "object",
                "required": [
                  "reason",
                  "owner",
                  "resume_condition",
                  "next_check_at",
                  "evidence"
                ],
                "properties": {
                  "reason": {
                    "type": "string",
                    "minLength": 1
                  },
                  "owner": {
                    "type": "string",
                    "minLength": 1
                  },
                  "resume_condition": {
                    "type": "string",
                    "minLength": 1
                  },
                  "next_check_at": {
                    "type": "string",
                    "format": "date-time"
                  },
                  "evidence": {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "minLength": 1
                    },
                    "minItems": 1
                  }
                }
              },
              {
                "type": "null"
              }
            ]
          },
          "candidate": {
            "anyOf": [
              {
                "type": "object",
                "required": [
                  "id",
                  "author"
                ],
                "properties": {
                  "id": {
                    "type": "string",
                    "minLength": 1
                  },
                  "author": {
                    "type": "string",
                    "minLength": 1
                  }
                }
              },
              {
                "type": "null"
              }
            ]
          },
          "review": {
            "anyOf": [
              {
                "type": "object",
                "required": [
                  "candidate",
                  "reviewer",
                  "verdict",
                  "reviewed_at",
                  "evidence"
                ],
                "properties": {
                  "candidate": {
                    "type": "string",
                    "minLength": 1
                  },
                  "reviewer": {
                    "type": "string",
                    "minLength": 1
                  },
                  "verdict": {
                    "enum": [
                      "approve",
                      "changes_requested"
                    ]
                  },
                  "reviewed_at": {
                    "type": "string",
                    "format": "date-time"
                  },
                  "evidence": {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "minLength": 1
                    },
                    "minItems": 1
                  }
                }
              },
              {
                "type": "null"
              }
            ]
          },
          "accepted": {
            "anyOf": [
              {
                "type": "object",
                "required": [
                  "candidate",
                  "by",
                  "accepted_at",
                  "evidence"
                ],
                "properties": {
                  "candidate": {
                    "type": "string",
                    "minLength": 1
                  },
                  "by": {
                    "type": "string",
                    "minLength": 1
                  },
                  "accepted_at": {
                    "type": "string",
                    "format": "date-time"
                  },
                  "evidence": {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "minLength": 1
                    },
                    "minItems": 1
                  }
                }
              },
              {
                "type": "null"
              }
            ]
          }
        }
      }
    }
  }
}
